{
  "name": "@latex-studio/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@latex-studio/latex-parser": "workspace:*",
    "@latex-studio/shared": "workspace:*",
    "fastify": "^5.12.5",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
